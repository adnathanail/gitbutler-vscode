{
  "name": "gitbutler-vscode",
  "displayName": "GitButler",
  "description": "View GitButler stacks and commit changes using the `but` CLI",
  "version": "0.0.1",
  "publisher": "adnathanail",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "workspaceContains:.git/gitbutler",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "GitButler",
      "properties": {
        "gitbutlerVscode.butPath": {
          "type": "string",
          "default": "but",
          "description": "Path to the GitButler `but` CLI executable."
        },
        "gitbutlerVscode.suggestDisablingGit": {
          "type": "boolean",
          "default": true,
          "description": "Suggest disabling VS Code's built-in Git integration in workspaces whose repository is managed by GitButler."
        }
      }
    },
    "commands": [
      {
        "command": "gitbutlerVscode.refresh",
        "title": "Refresh",
        "category": "GitButler",
        "icon": "$(refresh)"
      },
      {
        "command": "gitbutlerVscode.commitAll",
        "title": "Commit All Changes",
        "category": "GitButler",
        "icon": "$(check)"
      },
      {
        "command": "gitbutlerVscode.commitSelected",
        "title": "Commit Selected Changes",
        "category": "GitButler",
        "icon": "$(check)"
      },
      {
        "command": "gitbutlerVscode.openChange",
        "title": "Open Changes",
        "category": "GitButler"
      },
      {
        "command": "gitbutlerVscode.openInGitButler",
        "title": "Open in GitButler",
        "category": "GitButler",
        "icon": {
          "light": "resources/gitbutler-light.svg",
          "dark": "resources/gitbutler-dark.svg"
        }
      }
    ],
    "views": {
      "scm": [
        {
          "id": "gitbutlerVscode.stacks",
          "name": "GitButler Stacks",
          "icon": "resources/gitbutler-light.svg",
          "when": "gitbutlerVscode.hasRepository"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "gitbutlerVscode.commitSelected",
          "when": "false"
        },
        {
          "command": "gitbutlerVscode.openChange",
          "when": "false"
        },
        {
          "command": "gitbutlerVscode.openInGitButler",
          "when": "gitbutlerVscode.hasRepository"
        }
      ],
      "view/title": [
        {
          "command": "gitbutlerVscode.openInGitButler",
          "when": "view == gitbutlerVscode.stacks",
          "group": "navigation"
        },
        {
          "command": "gitbutlerVscode.refresh",
          "when": "view == gitbutlerVscode.stacks",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "gitbutlerVscode.openInGitButler",
          "when": "scmProvider == gitbutlerVscode",
          "group": "navigation"
        },
        {
          "command": "gitbutlerVscode.commitAll",
          "when": "scmProvider == gitbutlerVscode",
          "group": "navigation"
        },
        {
          "command": "gitbutlerVscode.refresh",
          "when": "scmProvider == gitbutlerVscode",
          "group": "navigation"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "gitbutlerVscode.commitSelected",
          "when": "scmProvider == gitbutlerVscode",
          "group": "inline"
        },
        {
          "command": "gitbutlerVscode.commitSelected",
          "when": "scmProvider == gitbutlerVscode",
          "group": "1_commit"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "pretest": "npm run compile",
    "test": "vscode-test",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^12.0.3",
    "typescript": "^5.6.0"
  }
}
