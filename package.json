{
  "name": "gitbutler-vscode",
  "displayName": "GitButler Stacks (Unofficial)",
  "description": "Unofficial: view GitButler stacks and commit changes using the `but` CLI. Not affiliated with GitButler, Inc.",
  "version": "0.0.0",
  "publisher": "adnathanail",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adnathanail/gitbutler-vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "workspaceContains:.git/gitbutler",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "GitButler",
      "properties": {
        "gitbutlerVscode.butPath": {
          "type": "string",
          "default": "but",
          "description": "Path to the GitButler `but` CLI executable."
        },
        "gitbutlerVscode.suggestDisablingGit": {
          "type": "boolean",
          "default": true,
          "description": "Suggest disabling VS Code's built-in Git integration in workspaces whose repository is managed by GitButler."
        }
      }
    },
    "commands": [
      {
        "command": "gitbutlerVscode.refresh",
        "title": "Refresh",
        "category": "GitButler",
        "icon": "$(refresh)"
      },
      {
        "command": "gitbutlerVscode.commitAll",
        "title": "Commit All Changes",
        "category": "GitButler",
        "icon": "$(check)"
      },
      {
        "command": "gitbutlerVscode.commitSelected",
        "title": "Commit Selected Changes",
        "category": "GitButler",
        "icon": "$(check)"
      },
      {
        "command": "gitbutlerVscode.discardSelected",
        "title": "Discard Changes",
        "category": "GitButler",
        "icon": "$(discard)"
      },
      {
        "command": "gitbutlerVscode.discardGroup",
        "title": "Discard All Changes",
        "category": "GitButler",
        "icon": "$(discard)"
      },
      {
        "command": "gitbutlerVscode.openChange",
        "title": "Open Changes",
        "category": "GitButler"
      },
      {
        "command": "gitbutlerVscode.openFile",
        "title": "Open File",
        "category": "GitButler",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitbutlerVscode.openInGitButler",
        "title": "Open in GitButler",
        "category": "GitButler",
        "icon": {
          "light": "resources/gitbutler-light.svg",
          "dark": "resources/gitbutler-dark.svg"
        }
      }
    ],
    "icons": {
      "gitbutler-vscode-logo": {
        "description": "GitButler bowtie",
        "default": {
          "fontPath": "resources/gitbutler-icons.woff",
          "fontCharacter": "\\E000"
        }
      }
    },
    "colors": [
      {
        "id": "gitbutlerVscode.addedResourceForeground",
        "description": "Colour of added files, when VS Code's Git integration is disabled. Defaults to Git's colour.",
        "defaults": {
          "light": "#587c0c",
          "dark": "#81b88b",
          "highContrast": "#81b88b",
          "highContrastLight": "#587c0c"
        }
      },
      {
        "id": "gitbutlerVscode.modifiedResourceForeground",
        "description": "Colour of modified files, when VS Code's Git integration is disabled. Defaults to Git's colour.",
        "defaults": {
          "light": "#895503",
          "dark": "#E2C08D",
          "highContrast": "#E2C08D",
          "highContrastLight": "#895503"
        }
      },
      {
        "id": "gitbutlerVscode.deletedResourceForeground",
        "description": "Colour of deleted files, when VS Code's Git integration is disabled. Defaults to Git's colour.",
        "defaults": {
          "light": "#ad0707",
          "dark": "#c74e39",
          "highContrast": "#c74e39",
          "highContrastLight": "#ad0707"
        }
      },
      {
        "id": "gitbutlerVscode.renamedResourceForeground",
        "description": "Colour of renamed files, when VS Code's Git integration is disabled. Defaults to Git's colour.",
        "defaults": {
          "light": "#007100",
          "dark": "#73C991",
          "highContrast": "#73C991",
          "highContrastLight": "#007100"
        }
      }
    ],
    "views": {
      "scm": [
        {
          "id": "gitbutlerVscode.stacks",
          "name": "GitButler Stacks",
          "icon": "resources/gitbutler-light.svg",
          "when": "gitbutlerVscode.hasRepository"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "gitbutlerVscode.commitSelected",
          "when": "false"
        },
        {
          "command": "gitbutlerVscode.discardSelected",
          "when": "false"
        },
        {
          "command": "gitbutlerVscode.discardGroup",
          "when": "false"
        },
        {
          "command": "gitbutlerVscode.openChange",
          "when": "false"
        },
        {
          "command": "gitbutlerVscode.openFile",
          "when": "isInDiffEditor && (resourceScheme == gitbutler-vscode-rev || resourceScheme == file && gitbutlerVscode.hasRepository && (!config.git.enabled || git.missing || gitOpenRepositoryCount == 0))"
        },
        {
          "command": "gitbutlerVscode.openInGitButler",
          "when": "gitbutlerVscode.hasRepository"
        }
      ],
      "view/title": [
        {
          "command": "gitbutlerVscode.openInGitButler",
          "when": "view == gitbutlerVscode.stacks",
          "group": "navigation"
        },
        {
          "command": "gitbutlerVscode.refresh",
          "when": "view == gitbutlerVscode.stacks",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "gitbutlerVscode.openFile",
          "when": "isInDiffEditor && (resourceScheme == gitbutler-vscode-rev || resourceScheme == file && gitbutlerVscode.hasRepository && (!config.git.enabled || git.missing || gitOpenRepositoryCount == 0))",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "gitbutlerVscode.openInGitButler",
          "when": "scmProvider == gitbutlerVscode",
          "group": "navigation"
        },
        {
          "command": "gitbutlerVscode.commitAll",
          "when": "scmProvider == gitbutlerVscode",
          "group": "navigation"
        },
        {
          "command": "gitbutlerVscode.refresh",
          "when": "scmProvider == gitbutlerVscode",
          "group": "navigation"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "gitbutlerVscode.discardGroup",
          "when": "scmProvider == gitbutlerVscode",
          "group": "inline"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "gitbutlerVscode.openFile",
          "when": "scmProvider == gitbutlerVscode && scmResourceState != removed",
          "group": "inline@1"
        },
        {
          "command": "gitbutlerVscode.discardSelected",
          "when": "scmProvider == gitbutlerVscode",
          "group": "inline@2"
        },
        {
          "command": "gitbutlerVscode.commitSelected",
          "when": "scmProvider == gitbutlerVscode",
          "group": "inline@3"
        },
        {
          "command": "gitbutlerVscode.openFile",
          "when": "scmProvider == gitbutlerVscode && scmResourceState != removed",
          "group": "navigation"
        },
        {
          "command": "gitbutlerVscode.commitSelected",
          "when": "scmProvider == gitbutlerVscode",
          "group": "1_commit"
        },
        {
          "command": "gitbutlerVscode.discardSelected",
          "when": "scmProvider == gitbutlerVscode",
          "group": "2_modification"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "pretest": "npm run compile",
    "test": "vscode-test",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "mocha": "^12.0.3",
    "typescript": "^5.6.0"
  }
}
